    {
      "type": "text",
      "id": "retry_text",
      "x": 1108, "y": 606, "width": 314, "height": 144,
      "text": "Retry-Logik (exponential backoff)\n\nattempt 1: query() -> timeout?\nattempt 2: sleep(1s) -> retry\nattempt 3: sleep(2s) -> retry\nattempt 4: sleep(4s) -> retry\nattempt 5: sleep(8s) -> retry\nmax 5 attempts | Timeout: 600s",
      "originalText": "Retry-Logik (exponential backoff)\n\nattempt 1: query() -> timeout?\nattempt 2: sleep(1s) -> retry\nattempt 3: sleep(2s) -> retry\nattempt 4: sleep(4s) -> retry\nattempt 5: sleep(8s) -> retry\nmax 5 attempts | Timeout: 600s",
      "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle",
      "strokeColor": "#94a3b8", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 103000, "version": 1, "versionNonce": 103001,
      "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": "retry_rect", "lineHeight": 1.25
