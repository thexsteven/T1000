      "type": "text", "id": "title", "x": 60, "y": 30, "width": 1500, "height": 34,
      "text": "T1000 — Complete Work Map:  Master's Preprocessing Pipeline (prior work)  +  This Thesis's Physical Cross-Check Layer",
      "originalText": "T1000 — Complete Work Map:  Master's Preprocessing Pipeline (prior work)  +  This Thesis's Physical Cross-Check Layer",
      "fontSize": 25, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 100001, "version": 1, "versionNonce": 1, "isDeleted": false, "groupIds": [],
      "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "subtitle", "x": 60, "y": 74, "width": 1720, "height": 40,
      "text": "Two complementary theses on one dataset. Heydari's pipeline turns raw recordings into statistically validated cycles.\nThis thesis (Braun / T1000) adds a physical, population-independent floor, the checks the pipeline lacks, and a per-criterion transparency rating — on top of that validated output. Everything both theses contain is shown below.",
      "originalText": "Two complementary theses on one dataset. Heydari's pipeline turns raw recordings into statistically validated cycles.\nThis thesis (Braun / T1000) adds a physical, population-independent floor, the checks the pipeline lacks, and a per-criterion transparency rating — on top of that validated output. Everything both theses contain is shown below.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 100002, "version": 1, "versionNonce": 1, "isDeleted": false, "groupIds": [],
      "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.3
    },

