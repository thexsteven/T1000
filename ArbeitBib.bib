@book{forward_relevance_2002,
	title = {The relevance of software documentation, tools and technologies},
	abstract = {This paper highlights the results of a survey of software professionals. One of the goals of this survey was to uncover the perceived relevance (or lack thereof) of software documentation, and the tools and technologies used to maintain, verify and validate such documents. The survey results highlight the preferences for and aversions against software documentation tools. Participants agree that documentation tools should seek to better extract knowledge from core resources. These resources include the system's source code, test code and changes to both. Resulting technologies could then help reduce the effort required for documentation maintenance, something that is shown to rarely occur. Our data reports compelling evidence that software professionals value technologies that improve automation of the documentation process, as well as facilitating its maintenance.},
	author = {Forward, Andrew and Lethbridge, Timothy},
	month = nov,
	year = {2002},
	doi = {10.1145/585058.585065},
}

@inproceedings{radnejad_structure_2022,
	title = {Structure and criteria defining business value in agile software development based on hierarchical analysis},
	url = {https://ieeexplore.ieee.org/document/9732113},
	doi = {10.1109/DCHPC55044.2022.9732113},
	abstract = {In recent years, agile software development as the most popular development approach has been considered by software teams and companies. In this approach, the business value is one of the concepts that achieving it especially has been emphasized in the agile software project. Despite this emphasis, a formal and appropriate definition of this concept has not been provided. In this study, to solve this challenge, we present a formal structure including necessary values and criteria for defining business value. Using hierarchical analysis, these criteria were weighted. The results of the analysis show what is called business value is often from the customer's point of view that improving competitive position, operational income, and return on investment are the most important components. Data analysis also shows that the customer perspective, financial perspective, and user perspective have a great effect on the definition of business value.},
	urldate = {2025-06-27},
	booktitle = {2022 {Second} {International} {Conference} on {Distributed} {Computing} and {High} {Performance} {Computing} ({DCHPC})},
	author = {Radnejad, Mahsa and Gandomani, Taghi Javdani},
	month = mar,
	year = {2022},
	keywords = {Agile software development, Business, Companies, Data analysis, Distributed computing, High performance computing, Software, agile methods, business value, evaluation criteria, hierarchical analysis},
	pages = {117--122},
}

