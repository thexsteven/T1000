@incollection{hettl_selbstmanagement-tools_2013,
	address = {Wiesbaden},
	title = {Selbstmanagement-{Tools}: {Zeitmanagement}, {Arbeitsmethodik} und {Beseitigung} von {Ballast}},
	isbn = {9783658001001},
	shorttitle = {Selbstmanagement-{Tools}},
	url = {https://doi.org/10.1007/978-3-658-00100-1_19},
	abstract = {Zu den wichtigsten Werkzeugen einer Führungskraft gehört ein wirksames Selbstmanagement: Ein effektives Zeitmanagement hilft Ihnen, Freiräume für die wesentlichen Aufgaben zu schaffen, damit Sie Souveräntität über Ihre Zeit und To-Dos bewahren, anstatt sich von Unwesentlichem vereinnahmen zu lassen. Sie erfahren in diesem Beitrag, wie Sie Prioritäten anhand der Eisenhower-Matrix setzen und wie Sie durch eine effektive Arbeitsmethodik mehr erreichen, um mit Ihrer Arbeitslast leichter umzugehen. Dazu gehört unter anderem, dass Sie Ihren Schreibtisch als „Kommandozentrale“ optimal strukturieren, um die täglich einflutenden Informationsmassen zu handhaben, Telefonate wirksam führen, effektives Lesen trainieren sowie mit Störungen und Unterbrechungen gekonnt umgehen. Für Überflüssiges und Entbehrliches sollten Sie und Ihr Team einen systematischen Prozess des Ausmerzens und Ausmistens installieren, um sich und Ihre Mitarbeiter von Ballast zu befreien und Energie für lohnende Ziele und Projekte zu gewinnen.},
	language = {de},
	urldate = {2025-07-23},
	booktitle = {Mitarbeiterführung mit dem {LEAD}-{Navigator}®: {Erfolgreich} und wirksam führen},
	publisher = {Springer Fachmedien},
	author = {Hettl, Matthias},
	editor = {Hettl, Matthias},
	year = {2013},
	doi = {10.1007/978-3-658-00100-1_19},
	pages = {169--185},
}

@article{callula_structural_2024,
	title = {A {Structural} {Framework} for {Effective} {Time} {Management} in {Dynamic} {Work} {Environments}},
	volume = {8},
	doi = {10.33050/atm.v8i2.2256},
	abstract = {This paper presents a structural framework to enhance time management profi- ciency within dynamic work environments. The framework integrates prioritization techniques, task scheduling methods, delegation strategies, and technology utilization to optimize time allocation and productivity. The evaluation demonstrates significant improvements in time management efficiency and client satisfaction across various professional contexts. For instance, by employing the eisenhower Matrix and Pareto Principle, project managers achieved a 20\% im- provement in project completion times. The framework’s adaptability is further highlighted by a 25\% reduction in project turnaround time in a marketing agency and a 30\% increase in project visibility in a startup. These findings underscore the framework’s practical implementation as a holistic approach to managing time effectively and achieving long-term success. Continuous refinement, real- time feedback integration, and exploring the impact of emerging technologies are recommended for further enhancing the framework’s effectiveness. This research contributes valuable insights for organizations aiming to navigate the complexities of modern work environments.},
	journal = {APTISI Transactions on Management (ATM)},
	author = {Callula, Brigitta and Sana, Eirene and Jacqueline, Greisy and Nathalie, Julia and Maria, Lily},
	month = may,
	year = {2024},
	pages = {152--159},
}

